<Window x:Class="QuickStash.Views.AnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuickStash - Draw"
        Width="1100" Height="760" MinWidth="640" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Tool buttons (one of them is checked) -->
        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="9,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="{TemplateBinding Tag}" FontSize="14" Margin="0,0,6,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color swatches -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" Width="24" Height="24" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                            <Ellipse Width="16" Height="16" Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#606A75" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stroke size buttons -->
        <Style x:Key="SizeButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Width="26" Height="26" CornerRadius="4" Background="Transparent">
                            <Ellipse Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{StaticResource TextDimBrush}" x:Name="Dot" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Rectangle" x:Key="Divider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Fill" Value="{StaticResource BorderBrush}" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Height="40" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="14,0,8,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimizeClick" />
                        <Button Style="{StaticResource IconButton}" x:Name="MaximizeButton" Content="&#xE922;" ToolTip="Maximize" Click="OnMaximizeClick" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close without saving (Esc)" Click="OnCancelClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="DRAW" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="Subtitle" Margin="12,0,0,0" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RevertButton" Style="{StaticResource LinkButton}" Click="OnRevertClick" Margin="0,0,10,0"
                                ToolTip="Remove the drawing and keep the untouched screenshot">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7A7;" FontSize="11" Margin="0,0,5,0" />
                                <TextBlock Text="Revert to original" />
                            </StackPanel>
                        </Button>
                        <Button Content="Cancel" Click="OnCancelClick" Margin="0,0,6,0" />
                        <Button Style="{StaticResource AccentButton}" Content="Save" Click="OnSaveClick" Padding="18,5" ToolTip="Save (Ctrl+S)" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="PenTool" Style="{StaticResource ToolButton}" GroupName="Tool" Tag="&#xE76D;" Content="Pen" IsChecked="True"
                                     ToolTip="Pen (P)" Checked="OnToolChanged" />
                        <RadioButton x:Name="HighlighterTool" Style="{StaticResource ToolButton}" GroupName="Tool" Tag="&#xE7E6;" Content="Highlight"
                                     ToolTip="Highlighter for routes and areas (H)" Checked="OnToolChanged" />
                        <RadioButton x:Name="ArrowTool" Style="{StaticResource ToolButton}" GroupName="Tool" Tag="&#xE72A;" Content="Arrow"
                                     ToolTip="Arrow: drag from start to tip (A)" Checked="OnToolChanged" />
                        <RadioButton x:Name="EraserTool" Style="{StaticResource ToolButton}" GroupName="Tool" Tag="&#xE75C;" Content="Erase"
                                     ToolTip="Eraser: removes whole strokes (E)" Checked="OnToolChanged" />

                        <Rectangle Style="{StaticResource Divider}" />

                        <StackPanel x:Name="Swatches" Orientation="Horizontal" />

                        <Rectangle Style="{StaticResource Divider}" />

                        <RadioButton x:Name="SizeSmall" Style="{StaticResource SizeButton}" GroupName="Size" Tag="5" ToolTip="Thin ([)" Checked="OnSizeChanged" />
                        <RadioButton x:Name="SizeMedium" Style="{StaticResource SizeButton}" GroupName="Size" Tag="9" ToolTip="Medium" IsChecked="True" Checked="OnSizeChanged" />
                        <RadioButton x:Name="SizeLarge" Style="{StaticResource SizeButton}" GroupName="Size" Tag="14" ToolTip="Thick (])" Checked="OnSizeChanged" />

                        <Rectangle Style="{StaticResource Divider}" />

                        <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Click="OnUndoClick" Width="30" Height="28" FontSize="14" />
                        <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" Click="OnRedoClick" Width="30" Height="28" FontSize="14" />
                        <Button Style="{StaticResource DangerIconButton}" Content="&#xE74D;" ToolTip="Clear all drawing" Click="OnClearClick" Width="30" Height="28" FontSize="14" />

                        <TextBlock x:Name="Status" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#F0B429" FontSize="11.5" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Canvas: the image at its real pixel size, scaled to fit; strokes are recorded in image pixels -->
            <Grid Background="#0B0D11" ClipToBounds="True">
                <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="12">
                    <Grid x:Name="ImageHost">
                        <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                        <InkCanvas x:Name="Ink" Background="Transparent" Cursor="Pen"
                                   PreviewMouseLeftButtonDown="OnInkMouseDown" PreviewMouseMove="OnInkMouseMove" PreviewMouseLeftButtonUp="OnInkMouseUp" />
                    </Grid>
                </Viewbox>
            </Grid>
        </DockPanel>
    </Border>
</Window>
