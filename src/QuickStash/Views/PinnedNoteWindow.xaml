<Window x:Class="QuickStash.Views.PinnedNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QuickStash.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PinnedNoteViewModel}"
        Title="QuickStash pinned note"
        Width="280" SizeToContent="Height" MaxHeight="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Border x:Name="Frame" Background="{StaticResource WindowBrush}" CornerRadius="6" Padding="10,8,10,10"
            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
        <StackPanel>
            <DockPanel Margin="0,0,0,5">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="9" Margin="6,-2,-4,0"
                        Content="&#xE77A;" ToolTip="Unpin" Command="{Binding UnpinCommand}"
                        Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE718;" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding TopicName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="250" LineHeight="17"
                       Visibility="{Binding Text, Converter={StaticResource NullToVisibility}}" />
            <Border Margin="0,7,0,0" CornerRadius="3" ClipToBounds="True" HorizontalAlignment="Left"
                    Visibility="{Binding Image, Converter={StaticResource NullToVisibility}}">
                <Image Source="{Binding Image}" MaxWidth="258" MaxHeight="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBlock Text="Drag to move  ·  closes to click-through" FontSize="10" Foreground="{StaticResource TextFaintBrush}" Margin="0,6,0,0"
                       Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</Window>
