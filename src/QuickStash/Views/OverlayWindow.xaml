<Window x:Class="QuickStash.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QuickStash.ViewModels"
        xmlns:local="clr-namespace:QuickStash.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:OverlayViewModel}"
        Title="QuickStash"
        Width="760" Height="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8">
        <local:NotesView x:Name="Notes" CloseToolTip="Close (Esc)" />
    </Border>
</Window>
