<Window x:Class="QuickStash.Views.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QuickStash.ViewModels"
        xmlns:local="clr-namespace:QuickStash.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:OverlayViewModel}"
        Title="QuickStash"
        Width="900" Height="640" MinWidth="560" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Native resize/snap/maximize with our own dark title bar (the NotesView header is the caption area). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Root" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <local:NotesView x:Name="Notes" CloseToolTip="Hide (reopen from the tray)">
            <local:NotesView.HeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Padding="9,3" Margin="0,0,8,0" Command="{Binding CaptureCommand}"
                            ToolTip="Screenshot the game you were just playing and add it to its topic">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE722;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Capture game" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding FollowGame}" Content="&#xE7FC;"
                                  ToolTip="Follow the game: switch to its topic when it comes to the front" />
                    <ToggleButton Loaded="OnTopmostLoaded" Style="{StaticResource IconToggle}" Content="&#xE718;"
                                  ToolTip="Keep this window on top" Checked="OnTopmostChanged" Unchecked="OnTopmostChanged" />
                </StackPanel>
            </local:NotesView.HeaderContent>
            <local:NotesView.TrailingHeaderContent>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimizeClick" />
                    <Button Style="{StaticResource IconButton}" Loaded="OnMaximizeLoaded" Content="&#xE922;" ToolTip="Maximize" Click="OnMaximizeClick" />
                </StackPanel>
            </local:NotesView.TrailingHeaderContent>
        </local:NotesView>
    </Border>
</Window>
