<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>QuickStash</RootNamespace>
    <AssemblyName>QuickStash</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\QuickStash.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>QuickStash</Product>
    <Description>Lightweight overlay notes for gaming</Description>
    <Copyright>MIT License</Copyright>
    <!-- Smaller, faster startup; we don't need culture-specific formatting beyond the user's locale. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\QuickStash.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickStash.Tests" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
